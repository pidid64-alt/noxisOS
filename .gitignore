# --- noxis build outputs (23-fixes / 24-el-capitan) -------------------------
# Everything here is regenerated by `make` in 23-fixes/; none of it belongs in
# git. The disk images under 25-osfs11/ are deliberately NOT ignored -- they
# are the bootable artefacts of that tree.
*.o
*.elf
*.iso
*.map
*.dis
23-fixes/kernel.bin
23-fixes/os-image.bin
23-fixes/boot/bootsect.bin
23-fixes/isodir/
24-el-capitan/kernel.bin

# --- host unit tests --------------------------------------------------------
25-osfs11/tests/gfx_unit
25-osfs11/tests/wm_unit

# --- editor / tooling leftovers --------------------------------------------
# e.g. 23-fixes/drivers/screen.h.tmp.2610.b600bfbbd7fd
*.tmp
*.tmp.*
*.orig
*.rej

__pycache__/
*.py[cod]

# Fresh, locally rebuilt desktop images and tests (historical images stay tracked).
25-osfs11/build/
25-osfs11/tests/vga_unit
25-osfs11/tests/ipc_unit

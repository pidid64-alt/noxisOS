# ---------------------------------------------------------------------------
# NoxisOS Cachy Edition — package list for the live/install ISO
# ---------------------------------------------------------------------------
# One package per line; blank lines and '#' comments are ignored by mkarchiso.
# Everything listed here lands in the ISO *and* (because the installer unpacks
# the live image) in the freshly installed system, so keep it to things a
# desktop user actually wants.
#
# Repository sources:
#   * Arch Linux [core]/[extra]/[multilib]
#   * CachyOS      [cachyos]  (kernel, settings, chwd, keyring, installer)
# ---------------------------------------------------------------------------

# --- base system -----------------------------------------------------------
base
base-devel
arch-install-scripts
archlinux-keyring
shadow
sudo
nano
nano-syntax-highlighting
vim
neovim
micro
less
man-db
man-pages
texinfo
which
bash-completion
git
wget
curl
rsync
lftp
unzip
zip
p7zip
tar
tree
jq
ripgrep
fd
fzf
bat
htop
btop
fastfetch
inxi
pciutils
usbutils
hwinfo
dmidecode
lsof
pv
time
pacman-contrib
paru

# --- CachyOS integration ---------------------------------------------------
# Calamares loads Boost.Python at runtime; keep both the matching Boost
# development/runtime packages explicit so pacstrap cannot omit its ABI.
boost
boost-libs
cachyos-keyring
cachyos-mirrorlist
cachyos-v3-mirrorlist
cachyos-v4-mirrorlist
cachyos-rate-mirrors
cachyos-hooks
cachyos-settings
cachyos-wallpapers
chwd


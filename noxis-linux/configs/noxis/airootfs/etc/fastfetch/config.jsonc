{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/noxis/ascii-logo.txt",
        "padding": { "top": 1, "left": 2, "right": 4 },
        "color": { "1": "38;2;139;92;246", "2": "38;2;34;211;238" }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;139;92;246", "title": "38;2;34;211;238" },
        "key": { "width": 10 }
    },
    "modules": [
        { "type": "title", "format": "{user-name}@{host-name}" },
        "separator",
        { "type": "os",       "key": "  OS",       "format": "{pretty-name} {arch}" },
        { "type": "host",     "key": "  PC" },
        { "type": "kernel",   "key": "  KERNEL",   "format": "{release}" },
        { "type": "uptime",   "key": "  UPTIME",   "format": "{days}d {hours}h {minutes}m" },
        { "type": "packages", "key": "  PACKAGES", "format": "{count} (pacman)" },
        { "type": "shell",    "key": "  SHELL" },
        { "type": "wm",       "key": "  WM" },
        { "type": "terminal", "key": "  TERMINAL" },
        "break",
        { "type": "cpu",      "key": "  CPU",      "showPeCoreCount": true },
        { "type": "gpu",      "key": "  GPU" },
        { "type": "memory",   "key": "  MEMORY",   "format": "{used} / {total}" },
        { "type": "swap",     "key": "  SWAP",     "format": "{used} / {total}" },
        { "type": "disk",     "key": "  DISK",     "format": "{size-used} / {size-total} ({used-percentage})" },
        { "type": "localip",  "key": "  IP",       "format": "{ipv4}" },
        { "type": "battery",  "key": "  BATTERY" },
        { "type": "locale",   "key": "  LOCALE" },
        "break",
        "colors"
    ]
}

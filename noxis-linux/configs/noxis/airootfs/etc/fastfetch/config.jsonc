{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/noxis/ascii-logo.txt",
        "padding": { "top": 1, "left": 2 },
        "color": { "1": "38;2;139;92;246", "2": "38;2;34;211;238" }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;139;92;246" },
        "key": { "width": 12 }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "theme",
        "icons",
        "font",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "battery",
        "locale",
        "break",
        "colors"
    ]
}

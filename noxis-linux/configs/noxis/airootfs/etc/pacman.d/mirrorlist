# NoxisOS default Arch Linux mirrors.
#
# The first entry is CachyOS' CDN cache of the Arch repositories (geo-aware,
# usually the fastest option). Run "cachyos-rate-mirrors" or "reflector" to
# regenerate this list.
Server = https://archlinux.cachyos.org/repo/$repo/os/$arch
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch

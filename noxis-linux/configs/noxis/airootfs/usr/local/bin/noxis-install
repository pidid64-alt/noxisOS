#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# noxis-install — launch the graphical installer, or fall back to the TUI one
# ---------------------------------------------------------------------------
set -uo pipefail

if [[ ${1:-} == "--tui" ]]; then
    exec archinstall
fi

if command -v calamares >/dev/null; then
    echo "Starting the NoxisOS installer (Calamares)..."
    exec pkexec /usr/local/bin/noxis-run-as-root calamares -d
fi

if command -v archinstall >/dev/null; then
    echo "Calamares is not available on this medium; starting archinstall instead."
    exec archinstall
fi

echo "No installer found on this medium." >&2
exit 1
